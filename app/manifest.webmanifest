{
  "name": "Rökland — historien och guiden till vår del av Alnö",
  "short_name": "Rökland",
  "description": "En guide till Rökland på Alnö utanför Sundsvall — Alnö gamla kyrka, öns urgamla berggrund och den nya stadsdelen med 47 småhustomter. Historia, natur, kuriosa och en berättelse om Skansvägen 1.",
  "start_url": "/",
  "id": "/",
  "display": "standalone",
  "background_color": "hsl(164, 18%, 5%)",
  "theme_color": "hsl(165, 52%, 14%)",
  "orientation": "portrait",
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "dir": "ltr",
  "lang": "sv",
  "prefer_related_applications": false,
  "scope": "/",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
